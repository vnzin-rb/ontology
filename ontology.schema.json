{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ontology",
  "description": "Structural schema. The CLI also checks identifier uniqueness, class references and inheritance cycles.",
  "type": "object",
  "required": [
    "classes"
  ],
  "properties": {
    "classes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/class"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "instances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/instance"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "label": {
      "type": "string",
      "pattern": "\\S"
    },
    "class": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "parents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        }
      }
    },
    "relation": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "source": {
          "$ref": "#/$defs/identifier"
        },
        "target": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "instance": {
      "type": "object",
      "required": [
        "id",
        "class"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "class": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "$ref": "#/$defs/label"
        }
      }
    }
  }
}
